using System;
//Delegate Declaration
public delegate void Demo();
class Test
{
   public void Show()
   {
     Console.WriteLine("Show Method Called");
   }
     public void Display()
     {
       Console.WriteLine("Display Method Called");
     }
     public void Print()
     {
       Console.WriteLine("Print Method Called");
     }
}
class Program
{
   static void Main()
   {
      Test t = new Test();
         //Creating Multicast Delegate
         Demo d;
         d = t.Show;
         d += t.Display;
         d += t.Print;
         //Calling all methods together
         d();
         Console.ReadLine();
     }
}
