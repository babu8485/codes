using System;
//Single Inheritance
class Animal
{
     public void Eat()
     {
         Console.WriteLine("Animal can Eat ");
     }
}
class Dog : Animal
{
     public void Bark()
     {
         Console.WriteLine("Dog can Bark ");
     }
}
//Multilevel Inheritance
class Puppy : Dog
{
     public void Weep()
     {
         Console.WriteLine("Puppy can Weep ");
     }
}
//Hierarchical Inheritance
class Cat : Animal
{
     public void Meow()
     {
         Console.WriteLine("Cat can Meow ");
     }
}
class Program
{
     static void Main()
     {
         //Single Inheritance
         Dog d = new Dog();
         d.Eat();
         d.Bark();
         //Multilevel Inheritance
         Puppy p = new Puppy();
         p.Eat();
         p.Bark();
         p.Weep();
         //Hierarchical Inheritance
         Cat c = new Cat();
         c.Eat();
         c.Meow();
         Console.ReadLine();
     }
}
